VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Client-side note encryption (AES). Use a long random string in production.
# Combined with the signed-in user id so each account’s ciphertext is unique.
VITE_NOTE_ENCRYPTION_SECRET=

# Google Search Console HTML-file verification (optional).
# Set these in your host's build/environment settings (e.g. for www.myselfix.me).
# The file is written at build time into public/ and is gitignored.
# GOOGLE_SITE_VERIFICATION_FILENAME=googleXXXXXXXXXXXXXXXX.html
# GOOGLE_SITE_VERIFICATION_CONTENT=google-site-verification: googleXXXXXXXXXXXXXXXX.html
